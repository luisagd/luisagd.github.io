  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
