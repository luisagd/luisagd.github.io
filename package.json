{
  "name": "luisagd",
  "version": "1.0.1",
  "private": true,
  "description": "luisagd",
  "author": "luisagd",
  "keywords": [
    "vite"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 443",
    "develop": "vite --host 0.0.0.0 --port 443",
    "start": "vite --host 0.0.0.0 --port 443",
